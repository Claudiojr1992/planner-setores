{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix web --no-audit --no-fund",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/notificar.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/notificar", "schedule": "0 11 * * *" }
  ],
  "headers": [
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|config\\.js$).*)", "destination": "/index.html" }
  ]
}
