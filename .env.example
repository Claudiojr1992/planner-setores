# ================= Planner de Setores — configuração =================
# O INSTALAR.bat cria o arquivo .env a partir deste modelo, com senhas e chaves NOVAS.
# Se você copiar este arquivo manualmente, TROQUE as senhas/chaves antes de usar em produção.

# --- Endereço do sistema (usado nos links de e-mail e no login) ---
PORTA_WEB=8080
ENDERECO_PUBLICO=http://localhost:8080
NOME_SISTEMA=Planner de Setores

# --- Banco e chaves internas (gerados automaticamente) ---
POSTGRES_PASSWORD=planner-senha-local-troque
JWT_SECRET=planner-local-dev-secret-troque-em-producao-0123456789abcdef
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkyOTQ3NDM5LCJleHAiOjIxMDgzMDc0Mzl9.ht5aKNnFzxlMGPiAcZw1IAxIyqcSXjIrZ615_IVAXD8
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTI5NDc0MzksImV4cCI6MjEwODMwNzQzOX0.V2rQEMwnlb0cqrMc0VHGoI5bLFOFbSpBeoUKN9bJRpw

# --- E-mail (SMTP) — usado pelo login (recuperar senha) e pelas notificações ---
# Padrão: caixa de testes local Mailpit → http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
SMTP_NOME_REMETENTE=Planner de Setores
SMTP_EMAIL_REMETENTE=planner@suaempresa.com.br
# Exemplos:
#   Office 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SEGURO=false  (usuário e senha da caixa)
#   Gmail:      SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_SEGURO=true   (senha de app)
